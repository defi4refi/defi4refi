# defi4refi outreach credentials — copy to scripts/.env (gitignored).
# Pipeline runs without these; sending is skipped per-channel until configured.

# Bluesky (bsky.app -> Settings -> App Passwords)
BSKY_HANDLE=
BSKY_APP_PASSWORD=

# GitHub issue outreach — needs repo scope
GITHUB_TOKEN=

# SMTP email dispatch
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Telegram: bot token + chat_id of the t.me/defi4refi group (bot must be admin).
# Used for operator notifications / cycle reports — bots cannot DM leads.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional tuning
OLLAMA_MODEL=llama3.1-8b-tools-32k
OUTREACH_TOP_N=40
OUTREACH_MAX_SEND_PER_CHANNEL=5
OUTREACH_INTERVAL_MIN=360
